# ================================
# MySQL (Active Database - Phase 1)
# ================================
MYSQL_ROOT_PASSWORD=change_me_mysql_root_password
MYSQL_DATABASE=adei_db
MYSQL_USER=adei_user
MYSQL_PASSWORD=change_me_mysql_password

# ================================
# PostgreSQL (Staged for Phase 3)
# ================================
POSTGRES_DB=adei_pg
POSTGRES_USER=adei_pg_user
POSTGRES_PASSWORD=change_me_postgres_password

# ================================
# Backend API (Express + Sequelize)
# ================================
API_PORT=5001
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret_string
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ================================
# Frontend (React CRA Dev Server)
# ================================
REACT_APP_API_URL=http://localhost:5001
REACT_APP_ENV=development
GENERATE_SOURCEMAP=true


# ================================
# Initial Admin Setup (CLI Script)
# ================================
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@adei-ensaf.ma
ADMIN_PASSWORD=change_this_to_a_secure_12char_password


TRUST_PROXY=false